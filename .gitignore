# ===============================
# KnowFlow - Root .gitignore
# ===============================

# Maven / Java
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.dump
*.dumpstream

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables & secrets
.env
.env.local
.env.*.local

# Local File Storage & Backups
storage/
backend/storage/
backups/
deploy/backups/

# Logs
*.log
logs/

# IDE / Editor configuration
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS files
*.tsbuildinfo
.DS_Store
Thumbs.db
Desktop.ini
