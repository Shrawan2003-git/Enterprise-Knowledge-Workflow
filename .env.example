# KnowFlow Environment Configuration

# Application Profiles
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Configuration
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=your_secure_postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowflow
SPRING_DATASOURCE_USERNAME=knowflow
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# JWT Secret (minimum 256 bits HMAC-SHA)
KNOWFLOW_JWT_SECRET=replace_this_with_a_secure_random_base64_or_hex_encoded_key_256bits_minimum

# Storage Directory
KNOWFLOW_STORAGE_DIR=./storage

# Dev User Bootstrap Password
KNOWFLOW_DEV_PASSWORD=DevPassword123!
